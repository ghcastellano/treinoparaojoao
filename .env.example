# Configure these in Vercel Production and Preview. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Recommended direct connection for schema migrations:
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FAMILY_PASSWORD=CHOOSE_A_LONG_PRIVATE_PASSWORD
# Optional: separate database namespace for previews; production default is joao.
HOUSEHOLD_ID=joao
# Local development ONLY, never enabled on Vercel:
ENABLE_LOCAL_STORE=false
